# 复制为 .env 后使用。APP_KEY 必须换成随机值。
# 生成：node -e "console.log(require('crypto').randomBytes(256).toString('base64'))"

APP_ENV=development
APP_PORT=13000
APP_KEY=__CHANGE_ME__

API_BASE_PATH=/api/

# 数据库：SQLite 单文件。备份 = 复制这个文件。
# 路径相对 packages/server 目录。
DB_DIALECT=sqlite
DB_STORAGE=data/ledger.db
DB_LOGGING=off

# 初始管理员（NocoBase 后台 /admin 用，不是给老板用的）
INIT_ROOT_EMAIL=admin@ly-ledger.local
INIT_ROOT_PASSWORD=admin123
INIT_ROOT_NICKNAME=维护者
INIT_ROOT_USERNAME=admin

LOGGER_LEVEL=info

# 只监听回环地址，不对局域网暴露
APP_HOST=127.0.0.1
