{
  "name": "@ly-ledger/server",
  "version": "0.1.0",
  "private": true,
  "description": "烟酒台账后端 —— Fastify + SQLite，本地单机",
  "main": "src/index.ts",
  "scripts": {
    "migrate": "tsx src/db/run-migrate.ts",
    "start": "tsx src/index.ts",
    "dev": "tsx watch src/index.ts",
    "typecheck": "tsc --noEmit",
    "verify:model": "tsx src/db/verify-invariants.ts",
    "test": "node --import tsx --test \"src/**/*.test.ts\""
  },
  "dependencies": {
    "@fastify/static": "^10.1.4",
    "better-sqlite3": "^13.0.3",
    "dotenv": "^16.4.7",
    "fastify": "^5.12.5",
    "node-cron": "^4.6.0",
    "pinyin-pro": "^3.29.4",
    "write-excel-file": "^4.1.1",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@types/better-sqlite3": "^7.6.12",
    "@types/node": "^22.10.5",
    "tsx": "^4.23.13",
    "typescript": "^5.7.3"
  }
}
