{
  "name": "ly-ledger",
  "version": "0.1.0",
  "private": true,
  "description": "烟酒店进销存台账 —— Fastify + SQLite + React，本地单机运行",
  "engines": {
    "node": ">=20"
  },
  "workspaces": [
    "packages/*"
  ],
  "scripts": {
    "migrate": "npm run migrate -w @ly-ledger/server",
    "start": "npm run start -w @ly-ledger/server",
    "dev": "npm run dev -w @ly-ledger/server",
    "typecheck": "npm run typecheck -w @ly-ledger/server && npm run typecheck -w @ly-ledger/web",
    "verify:model": "npm run verify:model -w @ly-ledger/server",
    "test": "npm test -w @ly-ledger/server",
    "web:dev": "npm run dev -w @ly-ledger/web",
    "web:build": "npm run build -w @ly-ledger/web",
    "package": "npm run web:build && node packaging/build.mjs"
  },
  "license": "UNLICENSED",
  "devDependencies": {
    "esbuild": "^0.28.2"
  }
}
